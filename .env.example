# =============================================================================
# Nit's Cut — Environment Configuration (Task 4 Step 10: Resend SMTP)
#
# Copy this template to .env:
#   cp .env.example .env
#
# Fill in your private values in .env.
# .env is ignored by Git and must never be committed.
# =============================================================================

# SMTP Relay Server
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
RESEND_API_KEY=

# Sender and Test Recipient Addresses
EMAIL_FROM="Nit's Cut <onboarding@resend.dev>"
TEST_RECIPIENT_EMAIL=

# Verification Code HMAC Secret (generate 32+ random bytes, e.g. openssl rand -hex 32)
VERIFICATION_HMAC_SECRET=
