<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main style="display: flex; flex-direction: column; gap: var(--nc-layout-gap);">
  <!-- INTERMEDIATE VERSION: separate-page baseline created only for the Task 3 Step 1 collapse exercise. -->
  <section class="card">
    <div class="card-header">
      <div>
        <h1 class="card-title nc-type-headline-medium">Reset your password</h1>
        <p class="card-desc nc-type-body-medium">Enter your email and we will help you get back in.</p>
      </div>
    </div>

    <form style="display: flex; flex-direction: column; gap: var(--nc-layout-gap);">
      <div class="form-group">
        <label class="form-label" for="reset-email">Email</label>
        <input class="form-control" type="email" id="reset-email" name="email" autocomplete="email">
      </div>
      <div>
        <button class="btn btn-primary" type="button">Send reset link</button>
      </div>
    </form>

    <p class="card-desc nc-type-body-medium">
      <a href="/login" style="color: var(--nc-color-primary);">Back to log in</a>
    </p>
  </section>
</main>

<%- include('../partials/footer') %>
