<%- include('partials/head') %>
<%- include('partials/header') %>

<main style="display: flex; flex-direction: column; gap: var(--nc-layout-gap);">
  <section class="hero">
    <p class="eyebrow nc-type-label-large">Services &amp; Commission Guide</p>
    <h1 class="hero-title nc-type-display-large">Bespoke Tailoring &amp; Fitting Process</h1>
    <p class="hero-copy nc-type-body-large">Every garment from our workshop is individually measured, precision-cut, and hand-finished for unmatched posture alignment and enduring refinement.</p>
  </section>

  <div class="feature-grid">
    <article class="feature-item">
      <p class="feature-label nc-type-label-medium">Signature Garment</p>
      <h3 class="feature-title nc-type-title-large">Two-Piece Senator Native Wear</h3>
      <p class="feature-text nc-type-body-medium">Tailored with clean minimalist lines, structured collars, and tapered trousers, suitable for corporate and ceremonial occasions.</p>
    </article>

    <article class="feature-item">
      <p class="feature-label nc-type-label-medium">Ceremonial Attire</p>
      <h3 class="feature-title nc-type-title-large">Traditional Three-Piece Agbada</h3>
      <p class="feature-text nc-type-body-medium">Richly draped ceremonial robe with handcrafted embroidery motifs, paired with tailored inner tunic and trousers.</p>
    </article>

    <article class="feature-item">
      <p class="feature-label nc-type-label-medium">Everyday Precision</p>
      <h3 class="feature-title nc-type-title-large">Bespoke Fitted Trousers</h3>
      <p class="feature-text nc-type-body-medium">Custom rise, waistband side-adjusters, and tailored breaks constructed from wool-blend fabrics designed for daily comfort.</p>
    </article>
  </div>

  <section class="card">
    <div class="card-header">
      <div>
        <h2 class="card-title nc-type-title-large">Ready to Commission Your Next Garment?</h2>
        <p class="card-desc nc-type-body-medium">Return to the portal home to schedule your initial consultation and measurement session.</p>
      </div>
      <a href="/" class="btn btn-primary nc-type-label-large">Register Inquiry</a>
    </div>
  </section>
</main>

<%- include('partials/footer') %>